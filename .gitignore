# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
# Unity marks folders it must not import as assets with a trailing tilde, so the editor
# backup pattern above also swallows them. Samples~ is package content and must ship:
# without it the Package Manager offers a sample whose Import does nothing.
!Samples~/
!Samples~/**

# IDE
.vs/
.idea/
*.user

# Build output (should not exist in a source-only package, but just in case)
[Bb]in/
[Oo]bj/
